<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cổng Dịch vụ công - Bộ Tư pháp</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary-red: #D62D34;
      --dark-red: #B71C1C;
      --background: #F8F9FA;
      --white: #FFFFFF;
      --text-primary: #1A1A1A;
      --text-secondary: #666666;
      --border: #E5E7EB;
      --success: #00A65A;
      --warning: #F39C12;
      --container: 1400px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family: "Inter", "Roboto", Arial, sans-serif;
      color: var(--text-primary);
      background: var(--white);
      font-size: 16px;
      line-height: 1.6;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    img {
      display: block;
      max-width: 100%;
    }

    .container {
      width: min(var(--container), calc(100% - 48px));
      margin: 0 auto;
    }

    .site-header {
      position: fixed;
      inset: 0 0 auto 0;
      z-index: 50;
      background: var(--white);
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.08);
    }

    .top-bar {
      height: 40px;
      color: var(--white);
      background: var(--primary-red);
      font-size: 13px;
      font-weight: 600;
    }

    .top-bar .container,
    .main-header .container {
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }

    .top-contact,
    .top-welcome,
    .inline-item {
      display: flex;
      align-items: center;
      gap: 14px;
      white-space: nowrap;
    }

    .inline-item {
      gap: 7px;
    }

    .icon {
      width: 17px;
      height: 17px;
      flex: 0 0 auto;
    }

    .lang {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 30px;
      height: 24px;
      border: 1px solid rgba(255, 255, 255, 0.28);
      background: rgba(255, 255, 255, 0.12);
      font-size: 12px;
      font-weight: 700;
    }

    .main-header {
      height: 90px;
      background: var(--white);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 14px;
      min-width: 360px;
    }

    .brand-mark {
      width: 56px;
      height: 56px;
      display: grid;
      place-items: center;
      border-radius: 999px;
      color: var(--white);
      background: var(--primary-red);
      box-shadow: inset 0 -3px 0 rgba(0, 0, 0, 0.1);
    }

    .brand-mark svg {
      width: 30px;
      height: 30px;
    }

    .brand-eyebrow {
      margin: 0 0 2px;
      color: var(--primary-red);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 1.6px;
      text-transform: uppercase;
    }

    .brand-name {
      margin: 0;
      max-width: 350px;
      font-size: 18px;
      line-height: 1.25;
      font-weight: 800;
    }

    .nav {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 6px;
      flex: 1 1 auto;
    }

    .nav a {
      display: inline-flex;
      align-items: center;
      min-height: 42px;
      padding: 0 14px;
      border-radius: 8px;
      color: #333333;
      font-size: 15px;
      font-weight: 600;
      white-space: nowrap;
    }

    .nav a.active {
      color: var(--white);
      background: var(--primary-red);
    }

    .login-btn {
      height: 42px;
      padding: 0 22px;
      border: 1px solid var(--border);
      border-radius: 12px;
      color: var(--text-primary);
      background: var(--white);
      font: inherit;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
    }

    .hero {
      position: relative;
      min-height: 700px;
      margin-top: 130px;
      display: flex;
      align-items: center;
      overflow: hidden;
      color: var(--white);
      background-image:
        linear-gradient(90deg, rgba(0, 0, 0, 0.70) 0%, rgba(0, 0, 0, 0.55) 43%, rgba(0, 0, 0, 0.25) 100%),
        url("6dbbdc11689824af8b86ccde8d82f450.jpg");
      background-size: cover;
      background-position: center;
    }

    .hero-content {
      width: min(760px, 100%);
      padding: 70px 0;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 28px;
      padding: 8px 14px;
      border: 1px solid rgba(255, 255, 255, 0.26);
      border-radius: 999px;
      background: #fd000885;
      color: var(--white);
      font-size: 14px;
      font-weight: 700;
    }

    .hero h1 {
      margin: 0;
      font-size: 64px;
      line-height: 1.04;
      font-weight: 800;
      letter-spacing: 0;
    }

    .hero h1 span {
      color: #ffd000;
    }

    .hero p {
      max-width: 720px;
      margin: 24px 0 32px;
      font-size: 20px;
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.94);
    }

    .hero-actions,
    .card-action {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .btn {
      min-height: 52px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      padding: 0 26px;
      border-radius: 12px;
      border: 1px solid transparent;
      font-weight: 800;
      cursor: pointer;
    }

    .btn-red {
      background: var(--primary-red);
      color: var(--white);
    }

    .btn-outline-white {
      border-color: rgba(255, 255, 255, 0.72);
      background: transparent;
      color: var(--white);
    }

    .section {
      padding: 120px 0;
      background: var(--white);
    }

    .notice-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: 44px;
      align-items: start;
    }

    .notice-panel {
      display: grid;
      grid-template-columns: 62px minmax(0, 1fr);
      gap: 32px;
    }

    .vertical-label {
      height: 430px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 12px;
      border-radius: 10px;
      color: var(--white);
      background: var(--primary-red);
      font-size: 13px;
      font-weight: 800;
      text-transform: uppercase;
      writing-mode: vertical-rl;
      transform: rotate(180deg);
    }

    .vertical-label svg {
      transform: rotate(180deg);
    }

    .notice-content {
      padding-top: 6px;
      text-align: center;
    }

    .notice-content h2 {
      margin: 0 0 10px;
      font-size: 32px;
      line-height: 1.18;
      font-weight: 800;
    }

    .notice-content .intro {
      max-width: 850px;
      margin: 0 auto 32px;
      color: #465466;
    }

    .schedule-wrap {
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: 0;
      background: var(--white);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      min-width: 760px;
    }

    th,
    td {
      padding: 22px 20px;
      border-right: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      vertical-align: top;
      font-size: 15px;
    }

    th:last-child,
    td:last-child {
      border-right: 0;
    }

    tr:last-child td {
      border-bottom: 0;
    }

    thead th {
      color: #8C1D22;
      background: #FFF1F1;
      font-size: 13px;
      line-height: 1.45;
      font-weight: 800;
      text-transform: uppercase;
    }

    tbody th {
      width: 170px;
      color: var(--text-primary);
      background: #FFFDFC;
      font-weight: 800;
      text-transform: none;
    }

    .time-icon {
      display: inline-flex;
      width: 18px;
      margin-right: 8px;
      color: var(--warning);
    }

    .time-icon.blue {
      color: #0B8EA0;
    }

    .time-icon.brown {
      color: #A86A2B;
    }

    .notice-alert {
      display: flex;
      gap: 12px;
      margin-top: 22px;
      padding: 18px 22px;
      border: 1px solid #BCE4EF;
      border-radius: 8px;
      color: #27586A;
      background: #F1FBFE;
      text-align: left;
      font-size: 14px;
    }

    .side-photos {
      display: grid;
      gap: 16px;
    }

    .side-photos img {
      width: 100%;
      height: 150px;
      object-fit: cover;
      border-radius: 12px;
      border: 1px solid var(--border);
    }

    .services {
      background: linear-gradient(180deg, #FFFFFF 0%, #FFFCFC 100%);
    }

    .section-heading {
      text-align: center;
      margin-bottom: 58px;
    }

    .section-kicker {
      margin: 0 0 8px;
      color: var(--primary-red);
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 3px;
      text-transform: uppercase;
    }

    .section-heading h2 {
      margin: 0;
      font-size: 40px;
      line-height: 1.2;
      font-weight: 800;
    }

    .section-heading p {
      max-width: 620px;
      margin: 16px auto 0;
      color: #536171;
    }

    .service-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 24px;
    }

    .service-card {
      min-height: 310px;
      display: flex;
      flex-direction: column;
      padding: 24px;
      border: 1px solid var(--border);
      border-radius: 16px;
      background: var(--white);
      box-shadow: 0 6px 18px rgba(31, 41, 55, 0.05);
      transition: transform 160ms ease, box-shadow 160ms ease;
    }

    .service-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 12px 24px rgba(31, 41, 55, 0.09);
    }

    .service-card.red {
      border-color: #FFD6D8;
      background: #FFFAFA;
    }

    .service-card.yellow {
      border-color: #F8DCA3;
      background: #FFFDF8;
    }

    .service-card.teal {
      border-color: #BFE2E6;
      background: #F8FEFF;
    }

    .service-icon {
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      margin-bottom: 16px;
      border-radius: 8px;
      color: var(--white);
      background: var(--primary-red);
    }

    .yellow .service-icon,
    .yellow .service-button {
      background: #E99A00;
    }

    .teal .service-icon,
    .teal .service-button {
      background: #178A92;
    }

    .service-card h3 {
      margin: 0 0 18px;
      font-size: 20px;
      line-height: 1.25;
      font-weight: 800;
    }

    .service-card p {
      margin: 0 0 26px;
      color: #344253;
      font-size: 15px;
    }

    .service-button {
      width: 100%;
      min-height: 48px;
      margin-top: auto;
      border: 0;
      border-radius: 8px;
      background: var(--primary-red);
      color: var(--white);
      font-weight: 800;
      cursor: pointer;
    }

    .news {
      padding-top: 0;
      background: var(--white);
    }

    .news-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 32px;
    }

    .news-head h2 {
      margin: 0;
      font-size: 32px;
      line-height: 1.2;
      font-weight: 800;
    }

    .view-all {
      color: var(--primary-red);
      font-weight: 800;
    }

    .news-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }

    .news-card {
      min-height: 124px;
      padding: 22px;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: var(--white);
    }

    .news-tags {
      display: flex;
      gap: 8px;
      margin-bottom: 12px;
    }

    .tag {
      display: inline-flex;
      align-items: center;
      height: 24px;
      padding: 0 9px;
      border-radius: 999px;
      color: var(--primary-red);
      background: #FFF2F2;
      font-size: 12px;
      font-weight: 800;
      text-transform: uppercase;
    }

    .tag.new {
      color: #9A6200;
      background: #FFF5D7;
    }

    .news-card h3 {
      margin: 0 0 12px;
      font-size: 16px;
      line-height: 1.4;
      font-weight: 800;
    }

    .date {
      color: #6B7280;
      font-size: 14px;
    }

    .footer {
      padding: 64px 0 0;
      color: var(--white);
      background: #222222;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1.3fr 1fr 1fr 1fr;
      gap: 56px;
      padding-bottom: 58px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }

    .footer-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 22px;
    }

    .footer-mark {
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      border-radius: 8px;
      background: var(--primary-red);
    }

    .footer h3 {
      margin: 0 0 18px;
      color: #F3F4F6;
      font-size: 15px;
      letter-spacing: 1.2px;
      text-transform: uppercase;
    }

    .footer p,
    .footer a {
      color: rgba(255, 255, 255, 0.88);
      font-size: 15px;
    }

    .footer-links {
      display: grid;
      gap: 12px;
    }

    .copyright {
      min-height: 78px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      color: rgba(255, 255, 255, 0.8);
      font-size: 14px;
    }

    .chat {
      position: fixed;
      right: 28px;
      bottom: 28px;
      z-index: 60;
      min-height: 48px;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 0 18px;
      border-radius: 14px;
      color: var(--white);
      background: #050505;
      font-size: 14px;
      font-weight: 800;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.28);
    }

    .chat svg {
      color: #00D6C9;
    }

    @media (max-width: 1320px) {
      .brand {
        min-width: 310px;
      }

      .brand-name {
        font-size: 16px;
      }

      .nav a {
        padding: 0 8px;
        font-size: 13px;
      }
    }

    @media (max-width: 1080px) {
      .top-welcome span:first-child,
      .nav {
        display: none;
      }

      .hero h1 {
        font-size: 50px;
      }

      .notice-grid,
      .service-grid,
      .news-grid,
      .footer-grid {
        grid-template-columns: 1fr 1fr;
      }

      .side-photos {
        grid-template-columns: repeat(3, 1fr);
        grid-column: 1 / -1;
      }
    }

    @media (max-width: 760px) {
      .container {
        width: min(100% - 28px, var(--container));
      }

      .top-bar {
        height: auto;
        padding: 8px 0;
      }

      .top-bar .container {
        flex-direction: column;
        align-items: flex-start;
        gap: 6px;
      }

      .top-contact {
        flex-wrap: wrap;
        gap: 8px 14px;
      }

      .main-header {
        height: 86px;
      }

      .main-header .container {
        gap: 12px;
      }

      .brand {
        min-width: 0;
      }

      .brand-mark {
        width: 46px;
        height: 46px;
      }

      .brand-name {
        font-size: 14px;
      }

      .login-btn {
        padding: 0 14px;
      }

      .hero {
        min-height: 620px;
        margin-top: 136px;
      }

      .hero h1 {
        font-size: 38px;
      }

      .hero p {
        font-size: 17px;
      }

      .hero-actions {
        align-items: stretch;
        flex-direction: column;
      }

      .section {
        padding: 76px 0;
      }

      .notice-grid,
      .notice-panel,
      .service-grid,
      .news-grid,
      .footer-grid {
        grid-template-columns: 1fr;
      }

      .vertical-label {
        width: 100%;
        height: 56px;
        flex-direction: row;
        writing-mode: horizontal-tb;
        transform: none;
      }

      .vertical-label svg {
        transform: none;
      }

      .notice-content {
        text-align: left;
      }

      .notice-content h2,
      .news-head h2 {
        font-size: 28px;
      }

      .side-photos {
        grid-template-columns: 1fr;
      }

      .section-heading h2 {
        font-size: 32px;
      }

      .news-head,
      .copyright {
        align-items: flex-start;
        flex-direction: column;
      }
      }

      .profile-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin: 32px 0 24px;
      }

      .profile-grid {
        display: grid;
        grid-template-columns: minmax(280px, 360px) minmax(280px, 1fr);
        gap: 24px;
      }

      .profile-card {
        padding: 28px;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: var(--white);
        box-shadow: 0 12px 30px rgba(31, 41, 55, 0.06);
      }

      .profile-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 20px;
      }

      .profile-card-header h3 {
        margin: 0;
        font-size: 22px;
        line-height: 1.2;
      }

      .avatar-large {
        width: 64px;
        height: 64px;
        display: grid;
        place-items: center;
        border-radius: 18px;
        color: var(--white);
        background: var(--primary-red);
        font-size: 20px;
        font-weight: 800;
      }

      .profile-summary-list {
        display: grid;
        gap: 10px;
      }

      .profile-name {
        font-size: 24px;
        font-weight: 800;
      }

      .profile-role {
        color: #4B5563;
        font-size: 15px;
      }

      .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 36px;
        padding: 0 14px;
        border-radius: 999px;
        background: var(--primary-red);
        color: var(--white);
        font-size: 14px;
        font-weight: 700;
        width: fit-content;
      }

      .profile-field-grid {
        display: grid;
        gap: 16px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .profile-field-grid label {
        display: flex;
        flex-direction: column;
        gap: 8px;
        font-size: 14px;
        color: var(--text-secondary);
      }

      .profile-field-grid input,
      .profile-field-grid textarea {
        width: 100%;
        min-height: 44px;
        padding: 12px 14px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: #F8F9FA;
        color: var(--text-primary);
        font: inherit;
      }

      .profile-field-grid textarea {
        min-height: 100px;
        resize: vertical;
      }

      .profile-field-grid input[readonly],
      .profile-field-grid textarea[readonly] {
        background: #F4F5F7;
        color: var(--text-secondary);
        cursor: default;
      }

      .profile-field-grid label.full {
        grid-column: 1 / -1;
      }

      .card-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 22px;
      }

      .modal {
        position: fixed;
        inset: 0;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: rgba(0, 0, 0, 0.45);
        z-index: 120;
      }

      .modal.is-visible {
        display: flex;
      }

      .modal-inner {
        width: min(520px, 100%);
        background: var(--white);
        border-radius: 20px;
        padding: 28px;
        box-shadow: 0 24px 70px rgba(0, 0, 0, 0.16);
      }

      .modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 18px;
      }

      .modal-header h3 {
        margin: 0;
        font-size: 22px;
      }

      .modal-close {
        width: 36px;
        height: 36px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: transparent;
        color: var(--text-primary);
        cursor: pointer;
        font-size: 18px;
        display: grid;
        place-items: center;
      }

      .modal-body {
        display: grid;
        gap: 16px;
      }

      .modal-body label {
        display: grid;
        gap: 8px;
        font-size: 14px;
        color: var(--text-secondary);
      }

      .modal-body input {
        width: 100%;
        min-height: 44px;
        padding: 12px 14px;
        border-radius: 12px;
        border: 1px solid var(--border);
      }

      .modal-footer {
        margin-top: 16px;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
      }

      .modal-error {
        color: #B71C1C;
        font-size: 14px;
        min-height: 18px;
      }

      @media (max-width: 1080px) {
        .profile-grid {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 760px) {
        .profile-actions {
          flex-direction: column;
        }

        .profile-field-grid {
          grid-template-columns: 1fr;
        }
      }
    }
  </style>
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <header class="site-header">
    <div class="top-bar">
